rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Chronos (カレンダー・付箋・ノート・時間割) - ログイン本人限定で保護
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 2. FloraFill (花と絵) - 認証ユーザー
    match /florafill_users/{userId}/{document=**} {
      allow read, write: if request.auth != null;
    }

    // 3. Sliding Sudoku - ランキング公開閲覧 & 新規登録
    match /rankings/{rankingId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // 4. Shift Board - 認証ユーザー
    match /shiftApp/{docId} {
      allow read, write: if request.auth != null;
    }

    // 5. Virtual Art Gallery - 公開ギャラリー展示室
    match /rooms/{roomId} {
      allow read, write: if true;
    }
    match /system/{docId} {
      allow read, write: if true;
    }
  }
}
